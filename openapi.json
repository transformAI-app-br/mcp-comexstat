{
  "openapi": "3.1.0",
  "info": {
    "title": "comexstat @ transformAI.app.br",
    "version": "0.2.0",
    "summary": "Estatísticas de comércio exterior do Brasil, com a procedência de cada resposta.",
    "description": "Consulta a API pública do Comex Stat, traduz códigos do padrão IBGE para os próprios do Comex Stat e devolve, junto com os dados, a consulta exata feita à fonte e a data de atualização. As mesmas operações existem como ferramentas MCP em https://transformai.app.br/mcp/comexstat. A fonte é o MDIC, sem vínculo com a transformAI.",
    "contact": {
      "name": "transformAI",
      "url": "https://transformai.app.br/"
    },
    "license": {
      "name": "Apache-2.0 (código); dados de origem do MDIC",
      "identifier": "Apache-2.0"
    }
  },
  "externalDocs": {
    "description": "Especificação TAI-BP-002",
    "url": "https://transformai.app.br/blueprints/comercio-exterior-comexstat"
  },
  "servers": [
    {
      "url": "https://transformai.app.br/api/v1/comexstat"
    }
  ],
  "tags": [
    {
      "name": "Tabelas",
      "description": "Códigos de produtos, países e blocos."
    },
    {
      "name": "Consultas",
      "description": "Exportações e importações com procedência."
    }
  ],
  "paths": {
    "/atualizacao": {
      "get": {
        "tags": [
          "Tabelas"
        ],
        "operationId": "atualizacao",
        "summary": "Última atualização",
        "description": "Data da última atualização do Comex Stat e último mês com dados, para os dados gerais e para os dados por município.",
        "responses": {
          "200": {
            "description": "Datas de atualização",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Atualizacao"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/FonteIndisponivel"
          }
        }
      }
    },
    "/produtos": {
      "get": {
        "tags": [
          "Tabelas"
        ],
        "operationId": "buscarProduto",
        "summary": "Buscar produto (NCM e SH)",
        "description": "Procura produtos pela descrição nas tabelas oficiais do Comex Stat. Retorna códigos NCM (8 dígitos) e do Sistema Harmonizado: SH6, SH4 e SH2. Use os códigos em consultar_comercio e consultar_municipios.",
        "parameters": [
          {
            "name": "texto",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80,
              "description": "Parte da descrição, como 'café não torrado' ou 'minério de ferro'."
            },
            "description": "Parte da descrição, como 'café não torrado' ou 'minério de ferro'."
          },
          {
            "name": "detalhe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "resumo",
                "completo"
              ],
              "description": "resumo (padrão): até 10 códigos por nível. completo: até 30."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produtos encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/EntradaInvalida"
          },
          "502": {
            "$ref": "#/components/responses/FonteIndisponivel"
          }
        }
      }
    },
    "/paises": {
      "get": {
        "tags": [
          "Tabelas"
        ],
        "operationId": "buscarPais",
        "summary": "Buscar país ou bloco econômico",
        "description": "Procura códigos de países e de blocos econômicos usados pelo Comex Stat.",
        "parameters": [
          {
            "name": "texto",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60,
              "description": "Nome ou parte do nome, como 'China' ou 'Mercosul'."
            },
            "description": "Nome ou parte do nome, como 'China' ou 'Mercosul'."
          }
        ],
        "responses": {
          "200": {
            "description": "Países e blocos encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/EntradaInvalida"
          },
          "502": {
            "$ref": "#/components/responses/FonteIndisponivel"
          }
        }
      }
    },
    "/comercio": {
      "post": {
        "tags": [
          "Consultas"
        ],
        "operationId": "consultarComercio",
        "summary": "Consultar exportações ou importações",
        "description": "Exportações ou importações do Brasil desde 1997: valor em US$ FOB, peso em kg e quantidade, com filtros e detalhamento por produto, país, bloco, UF, via e URF. UF vai por sigla; a tradução para os códigos próprios do Comex Stat é feita aqui e registrada na procedência. A resposta traz a consulta exata feita à API oficial e a data de atualização, para que o número possa ser refeito no Comex Stat. Por padrão responde resumido: os totais, as 10 maiores categorias com toda a série de tempo delas e o restante somado em \"outros\".",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fluxo": {
                    "type": "string",
                    "enum": [
                      "exportacao",
                      "importacao"
                    ]
                  },
                  "de": {
                    "type": "string",
                    "pattern": "^(199[7-9]|20[0-9]{2})-(0[1-9]|1[0-2])$",
                    "description": "Mês inicial, AAAA-MM, desde 1997-01."
                  },
                  "ate": {
                    "type": "string",
                    "pattern": "^(199[7-9]|20[0-9]{2})-(0[1-9]|1[0-2])$",
                    "description": "Mês final, AAAA-MM."
                  },
                  "por_mes": {
                    "type": "boolean",
                    "description": "Detalhar mês a mês. Padrão: false, total por ano."
                  },
                  "ncm": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{8}$"
                    },
                    "maxItems": 50,
                    "description": "Códigos NCM de 8 dígitos."
                  },
                  "sh6": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{6}$"
                    },
                    "maxItems": 50
                  },
                  "sh4": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{4}$"
                    },
                    "maxItems": 50,
                    "description": "Posições SH4, com zero à esquerda, como 0901."
                  },
                  "sh2": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{2}$"
                    },
                    "maxItems": 50
                  },
                  "pais": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{1,3}$"
                    },
                    "maxItems": 50,
                    "description": "Códigos de país do Comex Stat (use buscar_pais)."
                  },
                  "bloco": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{1,3}$"
                    },
                    "maxItems": 20,
                    "description": "Códigos de bloco econômico (use buscar_pais)."
                  },
                  "uf": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z]{2}$"
                    },
                    "maxItems": 27,
                    "description": "Siglas das UFs de origem (exportação) ou destino (importação) do produto."
                  },
                  "via": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{2}$"
                    },
                    "maxItems": 20,
                    "description": "Vias de transporte: 01 marítima, 04 aérea, 06 ferroviária, 07 rodoviária, entre outras."
                  },
                  "detalhar_por": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "ncm",
                        "sh6",
                        "sh4",
                        "sh2",
                        "pais",
                        "bloco",
                        "uf",
                        "via",
                        "urf"
                      ]
                    },
                    "maxItems": 3
                  },
                  "metricas": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "fob",
                        "kg",
                        "quantidade",
                        "frete",
                        "seguro",
                        "cif"
                      ]
                    },
                    "maxItems": 6,
                    "description": "Padrão: fob e kg. Frete, seguro e CIF só existem na importação."
                  },
                  "limite": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500,
                    "description": "No resumo, quantas categorias mostrar (país, produto, município...), das maiores para as menores em US$ FOB. Padrão: 10."
                  },
                  "detalhe": {
                    "type": "string",
                    "enum": [
                      "resumo",
                      "completo"
                    ],
                    "description": "resumo (padrão): as maiores categorias em US$ FOB, o restante somado em \"outros\" e os totais. completo: todas as linhas (até 500) e a procedência com instruções para refazer. Use completo só quando o usuário pedir a lista inteira."
                  }
                },
                "required": [
                  "fluxo",
                  "de",
                  "ate"
                ],
                "additionalProperties": false
              },
              "examples": {
                "cafe_mg": {
                  "summary": "Café (SH4 0901) exportado por MG em 2025, por país",
                  "value": {
                    "fluxo": "exportacao",
                    "de": "2025-01",
                    "ate": "2025-12",
                    "uf": [
                      "MG"
                    ],
                    "sh4": [
                      "0901"
                    ],
                    "detalhar_por": [
                      "pais"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Linhas, totais e procedência",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resultado"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/EntradaInvalida"
          },
          "502": {
            "$ref": "#/components/responses/FonteIndisponivel"
          }
        }
      }
    },
    "/municipios": {
      "post": {
        "tags": [
          "Consultas"
        ],
        "operationId": "consultarMunicipios",
        "summary": "Consultar por município",
        "description": "Exportações ou importações por município, desde 1997, com produto até o nível SH4 e país parceiro. Municípios vão pelo código IBGE e UFs pela sigla. O município é o do declarante da operação, não necessariamente o do produtor ou do comprador. Por padrão responde resumido: os totais, as 10 maiores categorias com toda a série de tempo delas e o restante somado em \"outros\".",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fluxo": {
                    "type": "string",
                    "enum": [
                      "exportacao",
                      "importacao"
                    ]
                  },
                  "de": {
                    "type": "string",
                    "pattern": "^(199[7-9]|20[0-9]{2})-(0[1-9]|1[0-2])$"
                  },
                  "ate": {
                    "type": "string",
                    "pattern": "^(199[7-9]|20[0-9]{2})-(0[1-9]|1[0-2])$"
                  },
                  "por_mes": {
                    "type": "boolean"
                  },
                  "municipio_ibge": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{7}$"
                    },
                    "maxItems": 50
                  },
                  "uf": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z]{2}$"
                    },
                    "maxItems": 27
                  },
                  "sh4": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{4}$"
                    },
                    "maxItems": 50
                  },
                  "sh2": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{2}$"
                    },
                    "maxItems": 50
                  },
                  "pais": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{1,3}$"
                    },
                    "maxItems": 50
                  },
                  "detalhar_por": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "municipio",
                        "sh4",
                        "sh2",
                        "pais",
                        "bloco",
                        "uf"
                      ]
                    },
                    "maxItems": 3
                  },
                  "metricas": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "fob",
                        "kg"
                      ]
                    },
                    "maxItems": 2
                  },
                  "limite": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500,
                    "description": "No resumo, quantas categorias mostrar (país, produto, município...), das maiores para as menores em US$ FOB. Padrão: 10."
                  },
                  "detalhe": {
                    "type": "string",
                    "enum": [
                      "resumo",
                      "completo"
                    ],
                    "description": "resumo (padrão): as maiores categorias em US$ FOB, o restante somado em \"outros\" e os totais. completo: todas as linhas (até 500) e a procedência com instruções para refazer. Use completo só quando o usuário pedir a lista inteira."
                  }
                },
                "required": [
                  "fluxo",
                  "de",
                  "ate"
                ],
                "additionalProperties": false
              },
              "examples": {
                "cafe_mg_municipios": {
                  "summary": "Café exportado por município de MG em 2025",
                  "value": {
                    "fluxo": "exportacao",
                    "de": "2025-01",
                    "ate": "2025-12",
                    "uf": [
                      "MG"
                    ],
                    "sh4": [
                      "0901"
                    ],
                    "detalhar_por": [
                      "municipio"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Linhas, totais e procedência",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resultado"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/EntradaInvalida"
          },
          "502": {
            "$ref": "#/components/responses/FonteIndisponivel"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "Tabelas"
        ],
        "operationId": "openapi",
        "summary": "Esta descrição",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "EntradaInvalida": {
        "description": "Parâmetro inválido",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "FonteIndisponivel": {
        "description": "O Comex Stat não respondeu ou recusou a consulta",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "required": [
          "erro"
        ],
        "properties": {
          "erro": {
            "type": "string"
          }
        }
      },
      "Atualizacao": {
        "type": "object",
        "properties": {
          "dados_gerais": {
            "type": "object",
            "properties": {
              "atualizado_em": {
                "type": "string",
                "format": "date"
              },
              "ultimo_mes": {
                "type": "string"
              }
            }
          },
          "dados_por_municipio": {
            "type": "object",
            "properties": {
              "atualizado_em": {
                "type": "string",
                "format": "date"
              },
              "ultimo_mes": {
                "type": "string"
              }
            }
          },
          "fonte": {
            "type": "string"
          },
          "documentacao": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Resultado": {
        "type": "object",
        "required": [
          "total_linhas",
          "categorias",
          "truncado",
          "totais",
          "linhas",
          "procedencia"
        ],
        "properties": {
          "total_linhas": {
            "type": "integer",
            "description": "Linhas devolvidas pela fonte."
          },
          "categorias": {
            "type": "integer",
            "description": "Categorias distintas (país, produto, município...), sem contar o tempo."
          },
          "truncado": {
            "type": "boolean",
            "description": "Verdadeiro se as linhas mostradas passariam de 500."
          },
          "outros": {
            "type": "object",
            "description": "No resumo: as categorias não mostradas, somadas.",
            "additionalProperties": {
              "type": "number"
            }
          },
          "aviso": {
            "type": "string"
          },
          "totais": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "linhas": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "ano": {
                  "type": "string"
                },
                "mes": {
                  "type": "string"
                },
                "pais": {
                  "type": "string"
                },
                "uf": {
                  "type": "string"
                },
                "municipio": {
                  "type": "string"
                },
                "municipio_ibge": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "fob_usd": {
                  "type": "number"
                },
                "kg": {
                  "type": "number"
                },
                "quantidade": {
                  "type": "number"
                },
                "frete_usd": {
                  "type": "number"
                },
                "seguro_usd": {
                  "type": "number"
                },
                "cif_usd": {
                  "type": "number"
                }
              }
            }
          },
          "procedencia": {
            "$ref": "#/components/schemas/Procedencia"
          }
        }
      },
      "Procedencia": {
        "type": "object",
        "required": [
          "fonte",
          "consulta",
          "dados_atualizados_em",
          "consultado_em"
        ],
        "properties": {
          "fonte": {
            "type": "string"
          },
          "consulta": {
            "type": "object",
            "properties": {
              "endpoint": {
                "type": "string"
              },
              "corpo": {
                "type": "object"
              }
            },
            "description": "A consulta exata enviada à API oficial."
          },
          "dados_atualizados_em": {
            "type": "string",
            "format": "date"
          },
          "ultimo_mes_disponivel": {
            "type": "string"
          },
          "consultado_em": {
            "type": "string",
            "format": "date-time"
          },
          "traducoes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "campo": {
                  "type": "string"
                },
                "de": {
                  "type": "string"
                },
                "para": {
                  "type": "string"
                }
              }
            }
          },
          "observacoes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "como_refazer": {
            "type": "string"
          },
          "especificacao": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
